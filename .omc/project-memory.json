  "build": {
    "buildCommand": "python3 - <<'PY'\nBW,BH=2000,2600\nS=[\n (\"rect(A)\",100,140,760,320,False),\n (\"square(B)\",1540,140,360,360,True),\n (\"L\",100,580,760,760,False),\n (\"circle\",1500,940,400,400,True),\n (\"office\",0,2000,560,600,False),\n (\"etc\",1440,2000,560,600,False),\n (\"door\",850,2480,300,120,False),\n]\ndef rct(s): n,x,y,w,h,_=s; return (x,y,x+w,y+h)\nok=True\nfor n,x,y,w,h,lock in S:\n    if x<0 or y<0 or x+w>BW or y+h>BH: print(\"OOB\",n); ok=False\n    if lock and w!=h: print(\"ASPECT!\",n); ok=False\ndef ov(a,b):\n    ax1,ay1,ax2,ay2=rct(a); bx1,by1,bx2,by2=rct(b)\n    return max(0,min(ax2,bx2)-max(ax1,bx1))>0 and max(0,min(ay2,by2)-max(ay1,by1))>0\nfor i in range(len(S)):\n    for j in range(i+1,len(S)):\n        if ov(S[i],S[j]): print(\"OVERLAP\",S[i][0],S[j][0]); ok=False\nprint(\"center aisle:\",1500-860,\"| storage bottom L/circle:\",580+760,\"/\",940+400)\nprint(\"staging gap L->office:\",2000-1340,\" circle->etc:\",2000-1340)\nprint(\"door center x:\",850+150,\" office right:\",0+560,\" etc left:\",1440,\" -> midpoint:\",(560+1440)/2)\nprint(\"left flank:\",850-560,\" right flank:\",1440-1150)\nprint(\"ALL OK\" if ok else \"FAIL\")\nPY\necho \"=== tsc/lint ===\"\npnpm typecheck 2>&1 | tail -2; echo \"TSC=$?\"; pnpm lint 2>&1 | tail -2; echo \"LINT=$?\"",
